<?xml version="1.0" encoding="utf-8"?>
<!-- Só na build de debug: permite testar a sincronização e a IA com um servidor local no computador
     (localhost com adb reverse, ou 10.0.2.2 no emulador), sem o balão do validador de anúncios nativos. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_debug">
        <meta-data android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED" android:value="false"/>
    </application>
</manifest>
